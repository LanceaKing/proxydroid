include_guard(GLOBAL)

# Keep this list aligned with the pinned, unmodified libevent release. 2.1.13
# has one native TLS transport (event_openssl); mbedTLS is not in this release.
set(TLS_BACKEND openssl CACHE STRING "libevent TLS backend: openssl")
set_property(CACHE TLS_BACKEND PROPERTY STRINGS openssl)
if(DEFINED PROXYDROID_TLS_BACKEND)
    message(FATAL_ERROR "PROXYDROID_TLS_BACKEND was removed; use -DTLS_BACKEND=openssl in a fresh build directory")
endif()
if(NOT TLS_BACKEND STREQUAL "openssl")
    message(FATAL_ERROR "TLS_BACKEND=${TLS_BACKEND} is not supported by libevent 2.1.13-stable; supported: openssl")
endif()
if(EVENT__DISABLE_OPENSSL)
    message(FATAL_ERROR "TLS_BACKEND=openssl conflicts with EVENT__DISABLE_OPENSSL=ON")
endif()
if(DEFINED EVENT__DISABLE_MBEDTLS)
    message(FATAL_ERROR "libevent 2.1.13-stable has no mbedTLS backend")
endif()

function(proxydroid_tls_setup)
    file(READ "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/dependencies.lock.json" lock)
    foreach(key version revision url sha256 options)
        string(JSON tls_${key} GET "${lock}" "${TLS_BACKEND}" "${key}")
    endforeach()
    if(PROXYDROID_TLS_ARCHIVE)
        set(tls_url "${PROXYDROID_TLS_ARCHIVE}")
        if(tls_url MATCHES "^file://(.*)$")
            set(encoded_path "${CMAKE_MATCH_1}")
            set(tls_local_archive "")
            # Python Path.as_uri() encodes spaces and other path characters.
            while(encoded_path MATCHES "^([^%]*)%([0-9A-Fa-f][0-9A-Fa-f])(.*)$")
                set(prefix "${CMAKE_MATCH_1}")
                set(hex "${CMAKE_MATCH_2}")
                set(encoded_path "${CMAKE_MATCH_3}")
                math(EXPR code "0x${hex}")
                if(code EQUAL 0)
                    message(FATAL_ERROR "Invalid NUL in TLS archive path")
                endif()
                string(ASCII ${code} character)
                string(APPEND tls_local_archive "${prefix}${character}")
            endwhile()
            string(APPEND tls_local_archive "${encoded_path}")
        elseif(NOT tls_url MATCHES "^[A-Za-z][A-Za-z0-9+.-]*://")
            get_filename_component(tls_local_archive "${tls_url}" ABSOLUTE)
        endif()
        if(DEFINED tls_local_archive)
            if(NOT EXISTS "${tls_local_archive}" OR IS_DIRECTORY "${tls_local_archive}")
                message(FATAL_ERROR "Missing TLS archive: ${tls_local_archive}")
            endif()
            file(SHA256 "${tls_local_archive}" actual_sha256)
            if(NOT actual_sha256 STREQUAL tls_sha256)
                message(FATAL_ERROR "TLS archive SHA-256 mismatch: ${tls_local_archive}")
            endif()
            set(tls_url "${tls_local_archive}")
        endif()
    endif()
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../openssl.cmake")
    set_property(TARGET OpenSSL::SSL PROPERTY PROXYDROID_VERSION "${tls_version}")

    add_library(proxydroid-tls INTERFACE)
    add_library(proxydroid-crypto INTERFACE)
    add_library(ProxyDroid::TLS ALIAS proxydroid-tls)
    add_library(ProxyDroid::Crypto ALIAS proxydroid-crypto)
    target_link_libraries(proxydroid-tls INTERFACE OpenSSL::SSL OpenSSL::Crypto)
    target_link_libraries(proxydroid-crypto INTERFACE OpenSSL::Crypto)
    string(TOUPPER "${CMAKE_BUILD_TYPE}" build_type)
    set(config "${TLS_BACKEND}|${tls_revision}|${tls_sha256}|${tls_options}|${tls_upstream_flags}|${CMAKE_C_COMPILER_ID}|${CMAKE_C_COMPILER_VERSION}|${CMAKE_BUILD_TYPE}|${CMAKE_C_FLAGS}|${CMAKE_C_FLAGS_${build_type}}|${CMAKE_SHARED_LINKER_FLAGS}|${ANDROID_ABI}|${ANDROID_PLATFORM}")
    string(SHA256 config_sha256 "${config}")
    set(identity "TLS ${TLS_BACKEND} ${tls_version} revision=${tls_revision} archive=${tls_sha256} config=${config_sha256}")
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/tls-generated")
    file(MAKE_DIRECTORY "${generated}")
    file(CONFIGURE OUTPUT "${generated}/tls-build-info.h" CONTENT
        "/* Generated; do not edit. */\n#define PROXYDROID_TLS_BUILD_INFO \"${identity}\"\n" @ONLY)
    foreach(target proxydroid-tls proxydroid-crypto)
        target_compile_definitions(${target} INTERFACE PROXYDROID_TLS_CONFIGURED=1)
        target_include_directories(${target} INTERFACE "${generated}")
    endforeach()
    file(CONFIGURE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/tls-build.json" CONTENT
        "{\"backend\":\"${TLS_BACKEND}\",\"version\":\"${tls_version}\",\"revision\":\"${tls_revision}\",\"archive_sha256\":\"${tls_sha256}\",\"config_sha256\":\"${config_sha256}\",\"identity\":\"${identity}\"}\n" @ONLY)
endfunction()
proxydroid_tls_setup()
